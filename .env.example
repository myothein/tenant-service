# Nonsecret template; secrets must come from an approved vault.
TENANT_ID=
PORT=3001
TENANT_DATABASE_URL_TEMPLATE=
DB_MAX_CONNECTIONS=10
# Production default: oidc; never use legacy admin keys in NODE_ENV=production
TENANT_ADMIN_AUTH_MODE=oidc
TENANT_OIDC_ISSUER=
TENANT_OIDC_JWKS_URL=
TENANT_OIDC_AUDIENCE=tenant-service
TENANT_OIDC_REQUIRED_ROLE=TENANT_ADMIN
TENANT_AGENT_API_KEY=
# CI/dev ONLY (never production):
# TENANT_ALLOW_DEV_API_KEY=true
# TENANT_ADMIN_AUTH_MODE=legacy
# TENANT_ADMIN_API_KEY=
